{
  "schemaVersion": 1,
  "slug": "pcf-choices-picker",
  "name": "Choices Picker",
  "tagline": "A Choice or Multi-Select Choice column as a keyboard-accessible picker.",
  "category": "pickers",
  "tags": [
    "react",
    "fluent",
    "choices",
    "optionset",
    "accessible"
  ],
  "control": {
    "namespace": "PCFHub",
    "constructor": "ChoicesPicker",
    "type": "virtual",
    "framework": "react_virtual",
    "manifestPath": "ChoicesPicker/ControlManifest.Input.xml"
  },
  "links": {
    "homepage": "https://github.com/pcfhub/pcf-choices-picker",
    "support": "https://github.com/pcfhub/pcf-choices-picker/issues",
    "license": "MIT"
  },
  "docs": {
    "path": "docs"
  },
  "media": {
    "logo": "media/logo.png",
    "screenshots": []
  },
  "demo": {
    "fidelity": "full",
    "bundle": "out/controls/ChoicesPicker/bundle.js",
    "styles": [
      "out/controls/ChoicesPicker/css/ChoicesPicker.css"
    ],
    "presets": [
      {
        "slug": "status-single",
        "name": "Single choice",
        "description": "A Choice column shown as pills, with one option selected.",
        "isDefault": true,
        "props": {
          "value": 2,
          "options": "[{\"Value\":1,\"Label\":\"Draft\",\"Color\":\"#616161\"},{\"Value\":2,\"Label\":\"In review\",\"Color\":\"#0F6CBD\"},{\"Value\":3,\"Label\":\"Approved\",\"Color\":\"#107C10\"},{\"Value\":4,\"Label\":\"Rejected\",\"Color\":\"#C4314B\"}]",
          "selectionMode": "single",
          "layout": "pills",
          "showColors": true
        }
      },
      {
        "slug": "skills-multi",
        "name": "Multi-select",
        "description": "A Multi-Select Choice column, three of six selected.",
        "props": {
          "value": [
            1,
            3,
            5
          ],
          "options": "[{\"Value\":1,\"Label\":\"TypeScript\",\"Color\":\"#3178C6\"},{\"Value\":2,\"Label\":\"Power Fx\",\"Color\":\"#742774\"},{\"Value\":3,\"Label\":\"Dataverse\",\"Color\":\"#0F6CBD\"},{\"Value\":4,\"Label\":\"Accessibility\",\"Color\":\"#107C10\"},{\"Value\":5,\"Label\":\"React\",\"Color\":\"#087EA4\"},{\"Value\":6,\"Label\":\"Fluent UI\",\"Color\":\"#5B2D90\"}]",
          "selectionMode": "multiple",
          "layout": "pills",
          "showColors": true
        }
      },
      {
        "slug": "stacked-list",
        "name": "Stacked list",
        "description": "The same multi-select column as Fluent checkboxes instead of pills.",
        "props": {
          "value": [
            2,
            4
          ],
          "options": "[{\"Value\":1,\"Label\":\"TypeScript\",\"Color\":\"#3178C6\"},{\"Value\":2,\"Label\":\"Power Fx\",\"Color\":\"#742774\"},{\"Value\":3,\"Label\":\"Dataverse\",\"Color\":\"#0F6CBD\"},{\"Value\":4,\"Label\":\"Accessibility\",\"Color\":\"#107C10\"},{\"Value\":5,\"Label\":\"React\",\"Color\":\"#087EA4\"},{\"Value\":6,\"Label\":\"Fluent UI\",\"Color\":\"#5B2D90\"}]",
          "selectionMode": "multiple",
          "layout": "list",
          "showColors": true
        }
      },
      {
        "slug": "empty",
        "name": "Nothing selected",
        "description": "The empty state, with option colours switched off.",
        "props": {
          "value": null,
          "options": "[{\"Value\":1,\"Label\":\"Draft\",\"Color\":\"#616161\"},{\"Value\":2,\"Label\":\"In review\",\"Color\":\"#0F6CBD\"},{\"Value\":3,\"Label\":\"Approved\",\"Color\":\"#107C10\"},{\"Value\":4,\"Label\":\"Rejected\",\"Color\":\"#C4314B\"}]",
          "selectionMode": "single",
          "layout": "pills",
          "showColors": false
        }
      }
    ]
  }
}
