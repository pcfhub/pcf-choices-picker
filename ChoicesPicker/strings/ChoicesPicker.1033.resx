  <data name="ChoicesPicker_Name"><value>Choices Picker</value></data>
  <data name="ChoicesPicker_Desc"><value>Shows a Choice or Multi-Select Choice column as a keyboard-accessible picker.</value></data>
  <data name="Value_Name"><value>Choice column</value></data>
  <data name="Value_Desc"><value>The Choice or Multi-Select Choice column this picker reads and writes.</value></data>
  <data name="Options_Name"><value>Options</value></data>
  <data name="Options_Desc"><value>Supplies the option list where the host has no column metadata, such as a canvas app. Accepts [{"Value":1,"Label":"Draft","Color":"#616161"}] or "1:Draft, 2:In review". Overrides the column’s own options when set.</value></data>
  <data name="SelectionMode_Name"><value>Selection mode</value></data>
  <data name="SelectionMode_Desc"><value>Applies to Multi-Select Choice columns only, which may be limited to one choice. A Choice column always allows exactly one, whatever this is set to.</value></data>
  <data name="SelectionMode_Auto_Name"><value>Automatic</value></data>
  <data name="SelectionMode_Single_Name"><value>Single</value></data>
  <data name="SelectionMode_Multiple_Name"><value>Multiple</value></data>
  <data name="Layout_Name"><value>Layout</value></data>
  <data name="Layout_Desc"><value>Draw the options as pills or as a stacked list.</value></data>
  <data name="Layout_Pills_Name"><value>Pills</value></data>
  <data name="Layout_List_Name"><value>Stacked list</value></data>
  <data name="ShowColors_Name"><value>Use option colours</value></data>
  <data name="ShowColors_Desc"><value>Tint a selected pill with the colour defined on the choice in Dataverse.</value></data>
  <data name="NoOptions"><value>No options are available for this column.</value></data>
  <data name="Masked"><value>You do not have permission to view this value.</value></data>
  <data name="Clear"><value>Clear selection</value></data>
  <data name="OverLimit"><value>This record holds more than one choice, but the field now allows only one. Remove options until one remains.</value></data>
