<?xml version="1.0" encoding="utf-8" ?>
<manifest>
  <!--
    The version here is what the Power Platform upgrades on, and the release
    workflow refuses to publish a tag that disagrees with it. Bump this in the
    same commit as the tag.
  -->
  <control namespace="PCFHub"
           constructor="ChoicesPicker"
           version="0.1.0"
           display-name-key="ChoicesPicker_Name"
           description-key="ChoicesPicker_Desc"
           control-type="virtual">

    <external-service-usage enabled="false" />

    <!--
      One bound property that accepts either kind of choice column, rather than
      two optional ones. A field control is placed on exactly one column, so two
      bound properties would leave one permanently unbound and force every read
      through a "which one did the maker actually use" branch.

      The runtime cost of the type-group is that `raw` is `number | number[] |
      null` — single-select and multi-select differ in arity, not in kind — so
      the code normalises to an array once, at the boundary.
    -->
    <type-group name="choice">
      <type>OptionSet</type>
      <type>MultiSelectOptionSet</type>
    </type-group>

    <property name="value"
              display-name-key="Value_Name"
              description-key="Value_Desc"
              of-type-group="choice"
              usage="bound"
              required="true" />

    <property name="layout"
              display-name-key="Layout_Name"
              description-key="Layout_Desc"
              of-type="Enum"
              usage="input"
              required="false"
              default-value="pills">
      <value name="pills" display-name-key="Layout_Pills_Name">pills</value>
      <value name="checkboxes" display-name-key="Layout_Checkboxes_Name">checkboxes</value>
    </property>

    <!--
      `attributes` is optional on the platform's own OptionSetProperty type
      (`attributes?: OptionSetMetadata | undefined`), so a host that does not
      supply column metadata leaves the picker with nothing to offer. This is
      the escape hatch: `12:In progress, 34:Blocked` or a JSON array. It is also
      what makes canvas usable, where choice metadata is not reliably present.
    -->
    <property name="options"
              display-name-key="Options_Name"
              description-key="Options_Desc"
              of-type="SingleLine.Text"
              usage="input"
              required="false" />

    <property name="showColors"
              display-name-key="ShowColors_Name"
              description-key="ShowColors_Desc"
              of-type="TwoOptions"
              usage="input"
              required="false"
              default-value="true" />

    <resources>
      <code path="index.ts" order="1" />
      <css path="css/ChoicesPicker.css" order="1" />
      <resx path="strings/ChoicesPicker.1033.resx" version="1.0.0" />
      <platform-library name="React" version="16.8.6" />
    </resources>

    <!--
      No feature-usage on purpose. This control renders and writes back a bound
      column and nothing else — no WebAPI, no device, no navigation — which is
      what lets the hub run it as a full-fidelity demo.
    -->
  </control>
</manifest>
